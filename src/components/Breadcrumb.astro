---
/**
 * 面包屑：只铺到「上一层」的板块／专题，不重复文章名。
 * 文章页的标题就在正下方，再在路径里写一遍是浪费一次视线。
 */
interface Item {
  label: string;
  /** 最后一项是上一层板块，给成链接，方便直接从文章跳回列表 */
  href?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<nav class="breadcrumb reading" aria-label="面包屑导航">
  <ol>
    {
      items.map((item, index) => (
        <li>
          {item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}
          {index < items.length - 1 && (
            <span class="crumb-sep" aria-hidden="true">
              ›
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
