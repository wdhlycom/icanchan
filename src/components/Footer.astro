---
import { ui, type Locale } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? 'en';
const t = ui[locale];
const base = locale === 'zh' ? '/zh' : '';
const year = new Date().getFullYear();
const rssHref = locale === 'zh' ? '/zh/rss.xml' : '/rss.xml';
const aboutLabel = locale === 'zh' ? '网站声明' : locale === 'es' ? 'Acerca de' : 'About';
const contactLabel = locale === 'zh' ? '联系' : locale === 'es' ? 'Contacto' : 'Contact';
/* 中文的「关于」并入「源流」、西语的「Acerca de」并入「Origen」，
   /zh/about/ 和 /es/about/ 只剩不收录的跳转页。页脚直接指向有内容的真页，
   别让读者和爬虫先撞上一扇写着「此页不算数」的门。英文 /about/ 本身就是真页。 */
const aboutHref =
  locale === 'zh' ? '/zh/lineage/' : locale === 'es' ? '/es/lineage/' : `${base}/about/`;
const contactHref = 'mailto:wdhly.com@gmail.com';
---

<footer class="site-footer">
  <div class="container footer-min">
    <nav class="footer-links" aria-label={t.footerNav}>
      <a href={aboutHref}>{aboutLabel}</a>
      <span class="sep" aria-hidden="true">·</span>
      <a href={rssHref}>RSS</a>
      <span class="sep" aria-hidden="true">·</span>
      <a href={contactHref}>{contactLabel}</a>
    </nav>
    <p class="footer-copy">© {year} icanchan.com</p>
  </div>
</footer>
