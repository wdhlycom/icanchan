---
import { isPublished } from '../../lib/publish';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const koans = (
    await getCollection(
      'essays',
      ({ data }) => !data.draft && isPublished(data) && data.section === 'koans'
    )
  ).sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

  return koans.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: koans[index - 1],
      next: koans[index + 1],
    },
  }));
}

interface Props {
  entry: CollectionEntry<'essays'>;
  prev?: CollectionEntry<'essays'>;
  next?: CollectionEntry<'essays'>;
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  path={`/koans/${entry.id}/`}
  noAlternates
  breadcrumb={[
    { label: 'Home', href: '/' },
    { label: 'Koans', href: '/koans/' },
    { label: entry.data.title },
  ]}
>
  <article>
    <Breadcrumb
      items={[
        { label: 'Home', href: '/' },
        { label: 'Koans', href: '/koans/' },
      ]}
    />

    {entry.data.cover && (
      <div class="container" style="padding-top:8px">
        <img class="article-cover" src={entry.data.cover} alt="" />
      </div>
    )}

    <header class="article-head reading">
      <span class="tag">{entry.data.category}</span>
      <h1>{entry.data.title}</h1>
      <p class="card-meta" style="margin-top:18px">{entry.data.readingTime} min read</p>
    </header>

    <div class="prose koan-prose reading">
      <Content />
    </div>

    <nav class="article-nav reading">
      <div>
        {prev && (
          <a href={`/koans/${prev.id}/`}>
            <span>Previous</span>
            {prev.data.title}
          </a>
        )}
      </div>
      <div style="text-align:right">
        {next && (
          <a href={`/koans/${next.id}/`}>
            <span>Next</span>
            {next.data.title}
          </a>
        )}
      </div>
    </nav>
  </article>
</BaseLayout>

<style is:global>
  /* A koan page has the same two landmarks as the Chinese column: the case
     quoted at the top, and the question left at the bottom. */
  .koan-prose blockquote:first-of-type {
    position: relative;
    padding-top: 48px;
    font-style: normal;
  }
  .koan-prose blockquote:first-of-type::before {
    content: 'The case';
    position: absolute;
    top: 18px;
    left: 28px;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-dark);
    font-style: normal;
    font-family: var(--sans);
  }
  .koan-prose > p:last-child:has(strong) {
    position: relative;
    margin-top: 60px;
    padding: 48px 26px 24px;
    border: 1px dashed var(--gold-light);
    border-radius: 12px;
    background: var(--paper-warm);
  }
  .koan-prose > p:last-child:has(strong)::before {
    content: 'Sit with this';
    position: absolute;
    top: 18px;
    left: 26px;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-dark);
    font-style: normal;
    font-family: var(--sans);
  }
</style>
