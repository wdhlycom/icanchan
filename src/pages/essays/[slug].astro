---
import { isPublished } from '../../lib/publish';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection, render } from 'astro:content';
import { sections } from '../../data/sections';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  /* 公案有自己的一栏 /koans/，不在禅生活里重复出页。 */
  const essays = (
    await getCollection('essays', ({ data }) => !data.draft && isPublished(data) && data.section !== 'koans')
  ).sort(
    (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999),
  );
  /* 中文同名篇未必在 /zh/essays/ 下：公案独立成 /zh/koans/。
     而且中文那篇可能还没到发布日，这时不该给出互链。 */
  const zhById = new Map((await getCollection('essaysZh')).map((e) => [e.id, e]));

  /* 文章页属于哪个板块，前后篇就只在该板块内排，避免禅生活与禅科学的 order 互相串。 */
  const grouped = new Map<string, typeof essays>();
  for (const entry of essays) {
    const key = entry.data.section;
    if (!grouped.has(key)) grouped.set(key, []);
    grouped.get(key)!.push(entry);
  }

  return essays.map((entry) => {
    const siblings = grouped.get(entry.data.section)!;
    const index = siblings.indexOf(entry);
    const zh = zhById.get(entry.id);
    const zhReady = !!zh && !zh.data.draft && isPublished(zh.data);
    const altPath = zhReady
      ? zh!.data.section === 'koans'
        ? `/zh/koans/${zh!.id}/`
        : `/zh/essays/${zh!.id}/`
      : undefined;
    return {
      params: { slug: entry.id },
      props: {
        entry,
        prev: siblings[index - 1],
        next: siblings[index + 1],
        altPath,
        noAlts: !zhReady,
      },
    };
  });
}

interface Props {
  entry: CollectionEntry<'essays'>;
  prev?: CollectionEntry<'essays'>;
  next?: CollectionEntry<'essays'>;
  altPath?: string;
  noAlts: boolean;
}

const { entry, prev, next, altPath, noAlts } = Astro.props;
const owner = sections.find((s) => s.slug === entry.data.section);
const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  path={`/essays/${entry.id}/`}
  altPath={altPath}
  noAlternates={noAlts}
>
  <article>
    <Breadcrumb
      items={[
        { label: 'Home', href: '/' },
        owner
          ? { label: owner.title, href: `/${owner.slug}/` }
          : { label: 'Chan & Life', href: '/essays/' },
      ]}
    />

    {entry.data.cover && (
      <div class="container" style="padding-top:8px">
        <img class="article-cover" src={entry.data.cover} alt="" />
      </div>
    )}

    <header class="article-head reading">
      <span class="tag">{entry.data.category}</span>
      <h1>{entry.data.title}</h1>
      <p class="card-meta" style="margin-top:18px">{entry.data.readingTime} min read</p>
    </header>

    <div class="prose reading">
      <Content />
    </div>

    <nav class="article-nav reading">
      <div>
        {prev && <a href={`/essays/${prev.id}/`}><span>Previous</span>{prev.data.title}</a>}
      </div>
      <div style="text-align:right">
        {next && <a href={`/essays/${next.id}/`}><span>Next</span>{next.data.title}</a>}
      </div>
    </nav>
  </article>
</BaseLayout>
