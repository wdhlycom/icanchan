---
import { isPublished } from '../../../lib/publish';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const articles = (
    await getCollection('articles', ({ data }) => !data.draft && isPublished(data) && data.series === 'glossary')
  ).sort((a, b) => a.data.chapter - b.data.chapter);
  return articles.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, prev: articles[index - 1], next: articles[index + 1] },
  }));
}

interface Props {
  entry: CollectionEntry<'articles'>;
  prev?: CollectionEntry<'articles'>;
  next?: CollectionEntry<'articles'>;
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
  noAlternates
  title={entry.data.title}
  description={entry.data.description}
  path={`/series/glossary/${entry.id}/`}
>
  <article>
    <Breadcrumb
      items={[
        { label: 'Home', href: '/' },
        { label: 'Series', href: '/series/' },
        { label: 'Glossary', href: '/series/glossary/' },
      ]}
    />

    <header class="article-head reading">
      <h1>{entry.data.title}</h1>
      <p class="card-meta" style="margin-top:22px">{entry.data.readingTime} min read</p>
    </header>

    <div class="prose reading">
      <Content />
    </div>

    <nav class="article-nav reading">
      <div>
        {prev && (
          <a href={`/series/glossary/${prev.id}/`}>
            <span>Previous</span>
            {prev.data.title}
          </a>
        )}
      </div>
      <div style="text-align:right">
        {next && (
          <a href={`/series/glossary/${next.id}/`}>
            <span>Next</span>
            {next.data.title}
          </a>
        )}
      </div>
    </nav>
  </article>
</BaseLayout>
