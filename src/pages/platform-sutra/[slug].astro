---
import { isPublished } from '../../lib/publish';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  /* 第 1 章有两篇（卖柴人、风动幡动）。章号相同就按 id 排，保证上下篇稳定。 */
  const articles = (
    await getCollection('articles', ({ data }) => !data.draft && isPublished(data) && data.series === 'platform-sutra')
  ).sort((a, b) => a.data.chapter - b.data.chapter || a.id.localeCompare(b.id));
  return articles.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: articles[index - 1],
      next: articles[index + 1],
    },
  }));
}

interface Props {
  entry: CollectionEntry<'articles'>;
  prev?: CollectionEntry<'articles'>;
  next?: CollectionEntry<'articles'>;
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  path={`/platform-sutra/${entry.id}/`}
>
  <article>
    <Breadcrumb
      items={[
        { label: 'Home', href: '/' },
        { label: 'The Platform Sutra', href: '/platform-sutra/' },
      ]}
    />

    <header class="article-head reading">
      <h1>{entry.data.title}</h1>
    </header>

    <div class="prose reading">
      <Content />
    </div>

    <nav class="article-nav reading">
      <div>
        {prev && (
          <a href={`/platform-sutra/${prev.id}/`}>
            <span>Previous</span>
            {prev.data.title}
          </a>
        )}
      </div>
      <div style="text-align:right">
        {next && (
          <a href={`/platform-sutra/${next.id}/`}>
            <span>Next</span>
            {next.data.title}
          </a>
        )}
      </div>
    </nav>
  </article>
</BaseLayout>
