---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="This page does not exist." path="/404/" noAlternates>
  <section class="page-head" style="padding-bottom:120px">
    <div class="container">
      <h1>Nothing here.</h1>
      <p>
        The page you asked for is not on the site. Which is, if you think about it, a perfectly Chan
        situation — the map was never the territory.
      </p>
      <div class="hero-actions" style="margin-top:36px">
        <a class="btn btn-solid" href="/">Back to the source</a>
        <a class="btn btn-ghost" href="/search/">Search instead</a>
      </div>
    </div>
  </section>
</BaseLayout>
