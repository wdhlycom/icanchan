---
import { isPublished } from '../../../../lib/publish';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const articles = (
    await getCollection('articlesEs', ({ data }) => !data.draft && isPublished(data) && data.series === 'buddhism-101')
  ).sort((a, b) => a.data.chapter - b.data.chapter || a.id.localeCompare(b.id));
  return articles.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, prev: articles[index - 1], next: articles[index + 1] },
  }));
}

interface Props {
  entry: CollectionEntry<'articlesEs'>;
  prev?: CollectionEntry<'articlesEs'>;
  next?: CollectionEntry<'articlesEs'>;
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
  locale="es"
  title={entry.data.title}
  description={entry.data.description}
  path={`/es/series/buddhism-101/${entry.id}/`}
>
  <article>
    <Breadcrumb
      items={[
        { label: 'Inicio', href: '/es/' },
        { label: 'Budismo', href: '/es/buddhism/' },
        { label: `Capítulo ${entry.data.chapter}` },
      ]}
    />

    <header class="article-head reading">
      <span class="tag">
        Capítulo {entry.data.chapter} · {entry.data.category}
      </span>
      <h1>{entry.data.title}</h1>
      <p class="card-meta" style="margin-top:22px">
        {entry.data.readingTime} min de lectura
      </p>
    </header>

    <div class="prose reading">
      <Content />
    </div>

    <nav class="article-nav reading">
      <div>
        {prev && (
          <a href={`/es/series/buddhism-101/${prev.id}/`}>
            <span>Anterior</span>
            {prev.data.title}
          </a>
        )}
      </div>
      <div style="text-align:right">
        {next && (
          <a href={`/es/series/buddhism-101/${next.id}/`}>
            <span>Siguiente</span>
            {next.data.title}
          </a>
        )}
      </div>
    </nav>
  </article>
</BaseLayout>
