---
import { isPublished } from '../../../lib/publish';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const essays = await getCollection('essaysEs', ({ data }) => !data.draft && isPublished(data));
const guide = essays.find((e) => e.data.section === 'buddhism');

const chapters = (
  await getCollection('articlesEs', ({ data }) => !data.draft && isPublished(data) && data.series === 'buddhism-101')
).sort((a, b) => a.data.chapter - b.data.chapter);

const chapterCount = chapters.length;
const chapterUrl = (id) =>
  chapters.some((c) => c.id === id) ? `/es/series/buddhism-101/${id}/` : '/es/buddhism/';

const paths = [
  { who: 'Empiezas de cero', what: 'Del capítulo 1 y sin saltos. Treinta capítulos, unas 56.000 palabras; dos semanas a ritmo tranquilo.', href: chapterUrl('01-abundant-everything-empty-something') },
  { who: 'Ya leíste los libros populares', what: 'Empieza por los capítulos 3 y 4, y salta al 28 para ver dónde se acaba la evidencia sobre mindfulness.', href: chapterUrl('03-not-what-you-think') },
  { who: 'No quieres leer, quieres practicar', what: 'Capítulo 22 sobre la distancia entre saber y hacer, 23 para el método, 25 para el momento en que llega una emoción.', href: chapterUrl('22-the-knowing-doing-gap') },
  { who: 'Sabes algo de budismo y buscas Chan', what: 'Salta los fundamentos y ve a la sección del Sutra. Huineng dirá mucho de esto otra vez, desde otro ángulo.', href: '/es/essays/' },
];
---

<BaseLayout
  locale="es"
  title="Budismo"
  description="Treinta capítulos para entender qué se preguntaba el budismo antes de convertirse en una práctica de almohadilla."
  path="/es/buddhism/"
>
  <section class="page-head">
    <div class="container">
      <h1>Budismo</h1>
      <p>El budismo no es solo un cojín y una postura. Occidente se quedó con la sentada y dejó el resto.</p>
    </div>
  </section>

  {guide && (
    <section class="section container" style="padding-top:20px;padding-bottom:48px">
      <a class="guide-card" href={`/es/essays/${guide.id}/`}>
        <span class="guide-kicker">Empieza aquí</span>
        <h2>{guide.data.title}</h2>
        <p>{guide.data.description}</p>
        <span class="card-meta">Léelo y luego elige por qué capítulo entrar</span>
      </a>
    </section>
  )}

  <section class="section container" style="padding-top:0">
    <div class="main-track">
      <div class="track-head">
        <h2>El recorrido principal</h2>
        <p>
          Treinta capítulos, de la primera verdad a un mapa de la mente que se puede usar. Numerados,
          encadenados, en orden. Todo lo demás en esta sección es un complemento o lo mismo visto
          desde otro ángulo.
        </p>
        <ul class="track-meta">
          <li>{chapterCount} capítulos</li>
          <li>Unas 56.000 palabras</li>
          <li>Cuatro semanas</li>
        </ul>
      </div>
      <div class="track-peek">
        {chapters.slice(0, 5).map((c) => (
          <a class="peek-row" href={`/es/series/buddhism-101/${c.id}/`}>
            <span class="peek-num">{String(c.data.chapter).padStart(2, '0')}</span>
            <span class="peek-ttl">{c.data.title}</span>
          </a>
        ))}
        <a class="peek-more" href="/es/buddhism/#capitulos">Los {chapterCount} capítulos →</a>
      </div>
    </div>
  </section>

  <section class="section container divider-top" id="capitulos">
    <div class="paths-intro" style="margin-bottom:40px">
      <h2>Todos los capítulos</h2>
    </div>
    {chapters.length > 0 ? (
      <ul class="read-index">
        {chapters.map((entry) => (
          <li>
            <a href={`/es/series/buddhism-101/${entry.id}/`}>
              <span class="ttl">
                {String(entry.data.chapter).padStart(2, '0')} · {entry.data.title}
              </span>
              <span class="meta">{entry.data.category} · {entry.data.readingTime} min</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="section-empty">Todavía no hay capítulos publicados.</p>
    )}
  </section>

  <section class="section container">
    <div class="paths-intro" style="margin-bottom:40px">
      <h2>Elige según dónde estás</h2>
    </div>
    <ul class="entry-list">
      {paths.map((p) => (
        <li>
          <a href={p.href}>
            <span class="entry-who">{p.who}</span>
            <span class="entry-what">{p.what}</span>
            <span class="entry-arrow">→</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .guide-card {
    display: block;
    padding: 44px 48px;
    background: var(--paper-warm);
    transition: background 0.4s;
  }
  .guide-card:hover { background: var(--white); }
  .guide-kicker { font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold-dark); }
  .guide-card h2 {
    font-size: clamp(28px, 3.6vw, 38px);
    margin: 14px 0 14px;
    line-height: 1.25;
    transition: color 0.3s;
  }
  .guide-card:hover h2 { color: var(--gold-dark); }
  .guide-card p { color: var(--muted); font-size: 16.5px; line-height: 1.85; margin-bottom: 14px; max-width: 720px; }
  .card-meta { font-size: 13px; color: var(--muted); }

  .main-track { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; }
  .track-head h2 { font-size: clamp(32px, 4vw, 44px); margin: 14px 0 18px; }
  .track-head > p { color: var(--muted); font-size: 16.5px; line-height: 1.9; margin-bottom: 24px; }
  .track-meta { list-style: none; padding: 0; margin: 0 0 30px; display: flex; gap: 28px; flex-wrap: wrap; }
  .track-meta li { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold-dark); }
  .track-peek { display: grid; gap: 2px; }
  .peek-row {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 16px;
    align-items: baseline;
    padding: 14px 10px;
    transition: background 0.35s, color 0.25s;
  }
  .peek-row:hover { background: linear-gradient(90deg, rgba(197, 168, 128, 0.08), transparent 70%); color: var(--gold-dark); }
  .peek-num { font-family: var(--serif); font-size: 14px; color: var(--gold-dark); }
  .peek-ttl { font-family: var(--serif); font-size: 20px; line-height: 1.45; }
  .peek-more { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--faint); padding: 16px 10px 0; transition: color 0.25s; }
  .peek-more:hover { color: var(--gold-dark); }

  .entry-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 2px; }
  .entry-list a {
    display: grid;
    grid-template-columns: 1fr 20px;
    gap: 8px 16px;
    padding: 24px 22px;
    height: 100%;
    transition: background 0.35s;
  }
  .entry-list a:hover { background: var(--paper-warm); }
  .entry-who { font-family: var(--serif); font-size: 20px; color: var(--ink); }
  .entry-what { font-size: 14.5px; line-height: 1.8; color: var(--muted); grid-column: 1; }
  .entry-arrow { grid-column: 2; grid-row: 1; color: var(--gold); font-size: 15px; }

  @media (max-width: 900px) {
    .main-track { grid-template-columns: 1fr; gap: 32px; }
    .entry-list { grid-template-columns: 1fr; }
    .guide-card { padding: 32px 24px; }
  }
</style>
