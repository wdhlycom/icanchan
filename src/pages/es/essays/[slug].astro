---
import { isPublished } from '../../../lib/publish';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const owner = (section: string) => (section === 'buddhism-guide' ? 'buddhism' : section);
  const essays = (
    await getCollection('essaysEs', ({ data }) => !data.draft && isPublished(data))
  ).sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
  const groups = new Map<string, CollectionEntry<'essaysEs'>[]>();
  for (const e of essays) {
    const key = owner(e.data.section);
    const list = groups.get(key) ?? [];
    list.push(e);
    groups.set(key, list);
  }
  return essays.map((entry) => {
    const list = groups.get(owner(entry.data.section)) ?? [];
    const index = list.findIndex((e) => e.id === entry.id);
    return {
      params: { slug: entry.id },
      props: {
        entry,
        prev: list[index - 1],
        next: list[index + 1],
      },
    };
  });
}

interface Props {
  entry: CollectionEntry<'essaysEs'>;
  prev?: CollectionEntry<'essaysEs'>;
  next?: CollectionEntry<'essaysEs'>;
}

const { entry, prev, next } = Astro.props;
const sectionLabel: Record<string, string> = {
  buddhism: 'Fundamentos',
  'science-of-chan': 'Ciencia',
  practice: 'Práctica',
  'platform-sutra': 'Sutra',
};
const ownerLabel = sectionLabel[entry.data.section] ?? 'Ensayos';
const breadcrumb = [
  { label: 'Inicio', href: '/es/' },
  { label: ownerLabel, href: '/es/essays/' },
  { label: entry.data.title },
];
const { Content } = await render(entry);
---

<BaseLayout
  locale="es"
  title={entry.data.title}
  description={entry.data.description}
  path={`/es/essays/${entry.id}/`}
  breadcrumb={breadcrumb}
>
  <article>
    <Breadcrumb items={breadcrumb.slice(0, -1)} />

    <header class="article-head reading">
      {entry.data.category && <span class="tag">{entry.data.category}</span>}
      <h1>{entry.data.title}</h1>
      <p class="card-meta" style="margin-top:18px">{entry.data.readingTime} min</p>
    </header>

    <div class="prose reading">
      {entry.data.cover && <img src={entry.data.cover} alt="" />}
      <Content />
    </div>

    <nav class="article-nav reading">
      <div>
        {prev && <a href={`/es/essays/${prev.id}/`}><span>Anterior</span>{prev.data.title}</a>}
      </div>
      <div style="text-align:right">
        {next && <a href={`/es/essays/${next.id}/`}><span>Siguiente</span>{next.data.title}</a>}
      </div>
    </nav>
  </article>
</BaseLayout>
