---
import BaseLayout from '../../layouts/BaseLayout.astro';
const isProd = import.meta.env.PROD;
---

<BaseLayout
  locale="zh"
  title="搜索"
  description="搜索站里的每一章、每一栏、每一页。"
  path="/zh/search/"
>
  {isProd && <link slot="head" rel="stylesheet" href="/pagefind/pagefind-ui.css" />}

  <section class="page-head">
    <div class="container">
      <h1>搜索</h1>
      <p>搜索在自己的浏览器里完成，不用登录，也不上传任何内容。</p>
    </div>
  </section>

  <section class="page-body container">
    <div id="search" class="search-box"></div>
    <p class="search-hint" id="search-hint">
      搜索索引随站点一起生成，正式上线后即可使用。
    </p>
  </section>
</BaseLayout>

<script>
  const hint = document.getElementById('search-hint');
  const initial = new URLSearchParams(window.location.search).get('q')?.trim() || '';

  if (import.meta.env.PROD) {
    const script = document.createElement('script');
    script.src = '/pagefind/pagefind-ui.js';
    script.onload = () => {
      const UI = window.PagefindUI;
      if (UI) {
        const ui = new UI({
          element: '#search',
          showSubResults: true,
          showImages: false,
          translations: {
            placeholder: '搜索章节…',
            zero_results: '没有找到「[SEARCH_TERM]」。',
          },
        });
        hint?.remove();
        if (initial) {
          try {
            ui.triggerSearch(initial);
          } catch {
            const input = document.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
            if (input) {
              input.value = initial;
              input.dispatchEvent(new Event('input', { bubbles: true }));
            }
          }
        }
      }
    };
    script.onerror = () => {
      if (hint) hint.textContent = '搜索索引还没生成，先运行 npm run build。';
    };
    document.body.appendChild(script);
  }
</script>
