---
import { isPublished } from '../../../lib/publish';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TinaIsland from '../../../components/tina/TinaIslandLocal.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const koans = (
    await getCollection('essaysZh', ({ data }) => !data.draft && isPublished(data) && data.section === 'koans')
  ).sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
  return koans.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: koans[index - 1],
      next: koans[index + 1],
    },
  }));
}

interface Props {
  entry: CollectionEntry<'essaysZh'>;
  prev?: CollectionEntry<'essaysZh'>;
  next?: CollectionEntry<'essaysZh'>;
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
/* 只有 `npm run tina` 才把正文包成可编辑区块；正常构建仍旧是原来那个 div。 */
const tinaMode = process.env.TINA_DEV === '1';
---

<BaseLayout
  locale="zh"
  noAlternates={true}
  title={entry.data.title}
  description={entry.data.description}
  path={`/zh/koans/${entry.id}/`}
>
  <article>
    <Breadcrumb
      items={[
        { label: '首页', href: '/zh/' },
        { label: '公案', href: '/zh/koans/' },
      ]}
    />


    <header class="article-head reading">
      <span class="eyebrow">公案</span>
      <h1>{entry.data.title}</h1>
    </header>

    {tinaMode ? (
      <TinaIsland
        name="zhKoan"
        wrapper={{ tag: 'div', className: 'prose koan-prose reading' }}
        params={{ slug: entry.id }}
        primary
      >
        <Content />
      </TinaIsland>
    ) : (
      <div class="prose koan-prose reading">
        <Content />
      </div>
    )}

    <nav class="article-nav reading">
      <div>
        {prev && (
          <a href={`/zh/koans/${prev.id}/`}>
            <span>上一则</span>
            {prev.data.title}
          </a>
        )}
      </div>
      <div style="text-align:right">
        {next && (
          <a href={`/zh/koans/${next.id}/`}>
            <span>下一则</span>
            {next.data.title}
          </a>
        )}
      </div>
    </nav>
  </article>
</BaseLayout>

<style is:global>
  /* 公案专属页型：原文引用块打「原文」角标，末尾加粗的问句渲染成「参究」卡 */
  .koan-prose blockquote:first-of-type {
    position: relative;
    padding-top: 48px;
    font-style: normal;
  }
  .koan-prose blockquote:first-of-type::before {
    content: '原文';
    position: absolute;
    top: 18px;
    left: 28px;
    font-size: 11px;
    letter-spacing: 0.22em;
    color: var(--gold-dark);
    font-style: normal;
    font-family: var(--sans);
  }
  .koan-prose > p:last-child:has(strong) {
    position: relative;
    margin-top: 60px;
    padding: 48px 26px 24px;
    border: 1px dashed var(--gold-light);
    border-radius: 12px;
    background: var(--paper-warm);
  }
  .koan-prose > p:last-child:has(strong)::before {
    content: '参究';
    position: absolute;
    top: 18px;
    left: 26px;
    font-size: 11px;
    letter-spacing: 0.22em;
    color: var(--gold-dark);
    font-style: normal;
    font-family: var(--sans);
  }
</style>
