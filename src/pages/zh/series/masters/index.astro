---
import { isPublished } from '../../../../lib/publish';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articlesZh', ({ data }) => !data.draft && isPublished(data) && data.series === 'masters');
const byId = new Map(articles.map((a) => [a.id, a]));

/* 谱系顺序。 */
const lineage = [
  { name: '佛陀', id: 'masters-04-buddha' },
  { name: '达摩', id: 'masters-01-bodhidharma' },
  { name: '慧可', id: 'masters-05-huike' },
  { name: '僧璨', id: 'masters-06-sengcan' },
  { name: '道信', id: 'masters-07-daoxin' },
  { name: '弘忍', id: 'masters-08-hongren' },
  { name: '慧能', id: 'masters-09-huineng' },
  { name: '慧能之后', id: 'masters-02-huineng-legacy' },
  { name: '五家', id: 'masters-03-five-houses' },
  { name: '虚云', id: 'masters-10-xuyun' },
];
---

<BaseLayout
  locale="zh"
  title="祖师传"
  description="从灵山的一枝花，到嵩山的一堵墙，再到续住这条线的虚云。一位祖师一篇，按谱系读。"
  path="/zh/series/masters/"
>
  <section class="page-head">
    <div class="container">
      <h1>祖师传</h1>
      <p>一位祖师，一篇。不写年谱，只写他在这条线上改了什么。</p>
    </div>
  </section>

  <section class="section container">
    <ol class="pin-list">
      {lineage.map((p) => {
        const entry = p.id ? byId.get(p.id) : null;
        return (
          <li class:list={['pin', { 'is-todo': !entry }]}>
            <div>
              <span class="pin-name">{p.name}</span>
              {entry ? (
                <span class="pin-links">
                  <a href={`/zh/series/masters/${entry.id}/`}>{entry.data.title} →</a>
                </span>
              ) : (
                <span class="pin-count">待写</span>
              )}
            </div>
          </li>
        );
      })}
    </ol>
  </section>
</BaseLayout>

<style>
  .pin-list { list-style: none; padding: 0; margin: 0; }
  .pin > div {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 18px;
    align-items: baseline;
    padding: 16px 12px;
  }
  .pin-name { font-family: var(--zh-head); font-size: 21px; letter-spacing: 0.05em; }
  .pin-count { font-size: 11px; letter-spacing: 0.12em; color: var(--faint); white-space: nowrap; }
  .pin.is-todo .pin-name { color: var(--faint); opacity: 0.62; }
  .pin-links { display: flex; flex-direction: column; gap: 6px; }
  .pin-links a {
    font-size: 14px;
    color: var(--gold-dark);
    border-bottom: 1px solid var(--gold-light);
    padding-bottom: 1px;
    width: fit-content;
    transition: border-color 0.25s;
  }
  .pin-links a:hover { border-color: var(--gold); }
  @media (max-width: 900px) {
    .pin > div { grid-template-columns: 1fr; gap: 6px; }
    .pin-count, .pin-links { grid-column: 1; }
  }
</style>
