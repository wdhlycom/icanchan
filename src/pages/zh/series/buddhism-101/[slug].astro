---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { categoryZh } from '../../../../i18n/ui';
import { localizeSection } from '../../../../data/sections-zh';
import { sectionBySlug } from '../../../../data/sections';

export async function getStaticPaths() {
  const articles = (await getCollection('articlesZh', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.chapter - b.data.chapter,
  );
  return articles.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, prev: articles[index - 1], next: articles[index + 1] },
  }));
}

interface Props {
  entry: CollectionEntry<'articlesZh'>;
  prev?: CollectionEntry<'articlesZh'>;
  next?: CollectionEntry<'articlesZh'>;
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const baseSection = sectionBySlug(entry.data.section);
const section = baseSection ? localizeSection(baseSection, 'zh') : null;
const category = categoryZh[entry.data.category] ?? entry.data.category;
---

<BaseLayout
  locale="zh"
  title={entry.data.title}
  description={entry.data.description}
  path={`/zh/series/buddhism-101/${entry.id}/`}
>
  <article>
    <div class="container" style="padding-top:56px">
      <img class="article-cover" src={entry.data.cover} alt="" />
    </div>

    <header class="article-head reading">
      <span class="tag">第 {entry.data.chapter} 章 · {category}</span>
      <h1>{entry.data.title}</h1>
      <p class="card-meta" style="margin-top:18px">
        {entry.data.readingTime} 分钟
        {section && (
          <>
            {' · '}
            <a class="link-underline" href={`/zh/${section.slug}/`}>{section.title}</a>
          </>
        )}
      </p>
    </header>

    <div class="prose reading">
      <Content />
    </div>

    <nav class="article-nav reading">
      <div>
        {prev && (
          <a href={`/zh/series/buddhism-101/${prev.id}/`}>
            <span>上一篇</span>
            {prev.data.title}
          </a>
        )}
      </div>
      <div style="text-align:right">
        {next && (
          <a href={`/zh/series/buddhism-101/${next.id}/`}>
            <span>下一篇</span>
            {next.data.title}
          </a>
        )}
      </div>
    </nav>
  </article>
</BaseLayout>
