---
import { isPublished } from '../../../lib/publish';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import TinaIsland from '../../../components/tina/TinaIslandLocal.astro';
import { getCollection, render } from 'astro:content';
import { localizedSections } from '../../../data/sections-zh';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  // 栏目归一化：栏目级导言「buddhism-guide」和主题文章「buddhism」同属佛学基础
  const owner = (section: string) => (section === 'buddhism-guide' ? 'buddhism' : section);
  /* 公案已升格为独立内容线，走 /zh/koans/[slug]，不再经散文页生成 */
  const essays = (
    await getCollection('essaysZh', ({ data }) => !data.draft && isPublished(data) && data.section !== 'koans')
  ).sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
  // 上一篇/下一篇只在同一栏目内串，不跨板块
  const groups = new Map<string, CollectionEntry<'essaysZh'>[]>();
  for (const e of essays) {
    const key = owner(e.data.section);
    const list = groups.get(key) ?? [];
    list.push(e);
    groups.set(key, list);
  }
  // 英文版有没有同 id 的文章？没有就不该输出 hreflang 互链（否则指向 404）
  const enIds = new Set((await getCollection('essays', ({ data }) => !data.draft && isPublished(data))).map((e) => e.id));
  return essays.map((entry) => {
    const list = groups.get(owner(entry.data.section)) ?? [];
    const index = list.findIndex((e) => e.id === entry.id);
    return {
      params: { slug: entry.id },
      props: {
        entry,
        prev: list[index - 1],
        next: list[index + 1],
        hasEn: enIds.has(entry.id),
      },
    };
  });
}

interface Props {
  entry: CollectionEntry<'essaysZh'>;
  prev?: CollectionEntry<'essaysZh'>;
  next?: CollectionEntry<'essaysZh'>;
  hasEn: boolean;
}

const { entry, prev, next, hasEn } = Astro.props;
// 短章的唯一归属板块：面包屑指向它，而不是再回 /essays/ 这个已经不再列文章的入口页
const owner = localizedSections('zh').find((s) => s.slug === entry.data.section);
// 两篇栏目级文章不属于任何主题板块，各自回自己的栏目
const ownerOverride: Record<string, { label: string; href: string }> = {
  'buddhism-guide': { label: '佛学基础', href: '/zh/buddhism/' },
  'zen-life': { label: '禅生活', href: '/zh/essays/' },
};
/* 完整三层：首页 → 栏目 → 文章标题。UI 面包屑只取前两层，JSON-LD 用完整三层。 */
const breadcrumb = [
  { label: '首页', href: '/zh/' },
  owner
    ? { label: owner.title, href: `/zh/${owner.slug}/` }
    : ownerOverride[entry.data.section] ?? { label: '禅生活', href: '/zh/essays/' },
  { label: entry.data.title },
];
const { Content } = await render(entry);
/* 只有 `npm run tina` 才把正文包成可编辑区块；正常构建仍旧是原来那个 div。 */
const tinaMode = process.env.TINA_DEV === '1';
---

<BaseLayout
  locale="zh"
  title={entry.data.title}
  description={entry.data.description}
  path={`/zh/essays/${entry.id}/`}
  noAlternates={!hasEn}
  breadcrumb={breadcrumb}
>
  <article>
    <Breadcrumb items={breadcrumb.slice(0, -1)} />


    <header class="article-head reading">
      <h1>{entry.data.title}</h1>
    </header>

    {tinaMode ? (
      <TinaIsland
        name="zhEssay"
        wrapper={{ tag: 'div', className: 'prose reading' }}
        params={{ slug: entry.id }}
        primary
      >
        <Content />
      </TinaIsland>
    ) : (
      <div class="prose reading">
        <Content />
      </div>
    )}

    <nav class="article-nav reading">
      <div>
        {prev && <a href={`/zh/essays/${prev.id}/`}><span>上一篇</span>{prev.data.title}</a>}
      </div>
      <div style="text-align:right">
        {next && <a href={`/zh/essays/${next.id}/`}><span>下一篇</span>{next.data.title}</a>}
      </div>
    </nav>
  </article>
</BaseLayout>
