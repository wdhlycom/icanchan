---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const essays = (await getCollection('essaysZh', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.chapter - b.data.chapter,
  );
  return essays.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, prev: essays[index - 1], next: essays[index + 1] },
  }));
}

interface Props {
  entry: CollectionEntry<'essaysZh'>;
  prev?: CollectionEntry<'essaysZh'>;
  next?: CollectionEntry<'essaysZh'>;
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
  locale="zh"
  title={entry.data.title}
  description={entry.data.description}
  path={`/zh/essays/${entry.id}/`}
>
  <article>
    <div class="container" style="padding-top:56px">
      <img class="article-cover" src={entry.data.cover} alt="" />
    </div>

    <header class="article-head reading">
      <span class="tag">{entry.data.category}</span>
      <h1>{entry.data.title}</h1>
      <p class="card-meta" style="margin-top:18px">约 {entry.data.readingTime} 分钟</p>
    </header>

    <div class="prose reading">
      <Content />
    </div>

    <nav class="article-nav reading">
      <div>
        {prev && <a href={`/zh/essays/${prev.id}/`}><span>上一篇</span>{prev.data.title}</a>}
      </div>
      <div style="text-align:right">
        {next && <a href={`/zh/essays/${next.id}/`}><span>下一篇</span>{next.data.title}</a>}
      </div>
    </nav>
  </article>
</BaseLayout>
