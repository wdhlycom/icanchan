---
import BaseLayout from '../layouts/BaseLayout.astro';
const isProd = import.meta.env.PROD;
---

<BaseLayout
  title="Search"
  description="Search every chapter, section and page on icanchan."
  path="/search/"
>
  {isProd && <link slot="head" rel="stylesheet" href="/pagefind/pagefind-ui.css" />}

  <section class="page-head">
    <div class="container">
      <h1>Search</h1>
      <p>Runs entirely in your browser on a static index. No account, nothing sent anywhere.</p>
    </div>
  </section>

  <section class="page-body container">
    <div id="search" class="search-box"></div>
    <p class="search-hint" id="search-hint">
      搜索索引在建站时生成。运行 <code>npm run build &amp;&amp; npm run preview</code> 后即可使用。
    </p>
  </section>
</BaseLayout>

<script>
  const hint = document.getElementById('search-hint');
  const initial = new URLSearchParams(window.location.search).get('q')?.trim() || '';

  if (import.meta.env.PROD) {
    const script = document.createElement('script');
    script.src = '/pagefind/pagefind-ui.js';
    script.onload = () => {
      const UI = window.PagefindUI;
      if (UI) {
        const ui = new UI({
          element: '#search',
          showSubResults: true,
          showImages: false,
          translations: {
            placeholder: 'Search chapters…',
            zero_results: 'Nothing found for [SEARCH_TERM].',
          },
        });
        hint?.remove();
        if (initial) {
          try {
            ui.triggerSearch(initial);
          } catch {
            const input = document.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
            if (input) {
              input.value = initial;
              input.dispatchEvent(new Event('input', { bubbles: true }));
            }
          }
        }
      }
    };
    script.onerror = () => {
      if (hint) hint.textContent = '搜索索引还没生成，先运行 npm run build。';
    };
    document.body.appendChild(script);
  }
</script>
